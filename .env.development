# 개발 서버(npm run dev)에만 들어가는 값이에요. 브라우저에 공개되는 값만 적어요.
# 백엔드 주소를 비워 두면 요청이 /api/v1로 가고, vite.config.ts의 proxy가 로컬 백엔드(http://localhost:8080)로 넘겨요.
# 다른 서버를 보고 싶으면 .env.development.local에 VITE_API_BASE_URL을 적어요(커밋하지 않아요).
VITE_API_BASE_URL=
# 네이버 지도 Client ID(네이버 클라우드 플랫폼 Maps). 공개되는 값이고, 콘솔에 등록한 사이트 주소에서만 동작해요. Client Secret은 넣지 않아요.
VITE_NAVER_MAP_KEY_ID=9e08yau9op
